{
  "name": "file-transfer-worker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run build && wrangler dev --local --port 8787",
    "dev:ui": "vite",
    "dev:assets": "vite build --watch",
    "db:local": "wrangler d1 execute file-transfer --local --file schema.sql",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "input-otp": "^1.5.0",
    "jose": "^6.0.10",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "1.79.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.28.1"
  }
}
